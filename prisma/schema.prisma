// =========================================================================
// KPIMS (Kosar Production & Inventory Management System)
// Complete Relational Database Schema (PostgreSQL + Prisma ORM)
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum PartCategory {
  RAW_MATERIAL   // مواد اولیه (کویل ورق، شیت، مقاطع، لوله)
  WIP_PART       // کار در جریان ساخت (بلنک، پوسته فرم‌خورده، قطعه مرحله‌ای)
  FINISHED_GOOD  // محصول نهایی آماده تحویل به خودروساز (ساپکو/ایران‌خودرو/سایپا)
  CONSUMABLE     // مواد مصرفی خط تولید (سیم جوش، رنگ، چسب، ساچمه)
}

enum ProcessType {
  SHEARING     // برش و نواربری ورق
  BLANKING     // بلنکینگ و پولک‌زنی
  DRAWING      // کشش عمیق و شکل‌دهی هیدرولیک
  PUNCH_FORM   // پانچ، سوراخ‌کاری و فرم‌دهی
  BENDING      // خم‌کاری با پرس برک یا قالب خم
  TRIMMING     // دوربری و پلیسه‌گیری
  SPOT_WELD    // پرس‌جوش مقاومتی نقطه‌ای
  CO2_WELD     // جوشکاری تحت گاز محافظ CO2
  PAINT        // فسفاته و رنگ کاتافورز (ED)
  ASSEMBLY     // مونتاژ، هِمینگ و پرچ‌کاری
}

enum MachineType {
  HYDRAULIC_PRESS     // پرس هیدرولیک (کشش سنگین و فرم‌دهی)
  MECHANICAL_PRESS    // پرس مکانیکی لنگ/اکستریک (بلنکینگ و ضربه‌ای سریع)
  PRESS_BRAKE         // پرس برک CNC خم‌کاری
  SHEARING_MACHINE    // قیچی گیوتین و خط نواربری
  SPOT_WELDER         // دستگاه جوش نقطه‌ای و پرس‌جوش
  CO2_WELDING_CELL    // سلول جوشکاری رباتیک یا دستی CO2
  PAINT_LINE          // خط شستشو و رنگ کاتافورز
  ASSEMBLY_BENCH      // ایستگاه مونتاژ و کنترل نهایی
}

enum MachineStatus {
  ACTIVE       // آماده به کار و در حال تولید
  MAINTENANCE  // در حال تعمیر و نگهداری برنامه‌ریزی شده (PM)
  BREAKDOWN    // توقف اضطراری به علت خرابی مکانیکی/برقی
  IDLE         // آماده به کار اما فاقد برنامه تولید
}

enum DieType {
  BLANKING_DIE      // قالب برش و بلنک اولیه
  DRAWING_DIE       // قالب کشش عمیق پوسته
  FORMING_DIE       // قالب فرم و اصلاح هندسی
  TRIMMING_DIE      // قالب دوربری لبه‌های اضافه
  PIERCING_DIE      // قالب سوراخ‌کاری دقیق
  PROGRESSIVE_DIE   // قالب پروگرسیو چند مرحله‌ای پیوسته
  COMPOUND_DIE      // قالب مرکب همزمان برش و سوراخ‌کاری
}

enum DieStatus {
  READY             // آماده تحویل و نصب در پرس
  ON_MACHINE        // روی پرس نصب شده و در حال تولید
  MAINTENANCE       // در کارگاه قالب‌سازی جهت پولیش، تیزکاری یا تعویض سنبه
  CALIBRATION       // در حال اندازه‌برداری CMM و کنترل ابعادی
  RETIRED           // از رده خارج به دلیل استهلاک کامل
}

enum WarehouseType {
  RAW_MATERIALS     // انبار رول و شیت ورق ساپکو
  WIP               // انبار پای خط و پای کار سالن پرس و جوش
  FINISHED_GOODS    // انبار محصولات نهایی بسته‌بندی شده
  SCRAP             // انبار ضایعات آهن و پرت ورق
  TOOLING_DIES      // انبار و قفسه‌های نگهداری قالب‌های پرس
}

enum DocumentStatus {
  DRAFT       // پیش‌نویس (قابل ویرایش)
  CONFIRMED   // تایید نهایی شده (غیرقابل تغییر ساختاری)
  CLOSED      // بسته شده و مختومه
  CANCELLED   // لغو شده پیش از ثبت نهایی
}

enum PostingStatus {
  UNPOSTED    // سند موقت، هنوز در کاردکس و موجودی ثبت نشده
  POSTED      // ثبت قطعی در کاردکس و گردش موجودی (غیرقابل ویرایش یا حذف)
  REVERSED    // ابطال شده به موجب سند برگشتی/اصلاحی
}

enum InventoryDocType {
  RECEIPT          // رسید انبار (ورود کالا از تامین‌کننده/ساپکو)
  ISSUE            // حواله انبار (خروج کالا برای خط تولید یا فروش)
  WIP_TRANSFER     // حواله انتقال بین انبارهای پای کار و سالن‌ها
  RETURN           // برگشت از خط تولید به انبار یا برگشت به ساپکو
  SCRAP            // سند ثبت ضایعات و افت کیفی
  COUNT_ADJUSTMENT // تعدیل کسری یا مازاد انبارگردانی
  INITIAL_BALANCE  // ثبت موجودی اول دوره
}

enum DocReferenceType {
  SAPCO_COIL           // رسید کلاف ورق ساپکو
  CUSTOMER_ORDER       // سفارش فروش خودروساز
  MANUFACTURING_ORDER  // دستور ساخت و حواله مواد اولیه
  SCRAP_REPORT         // گزارش ضایعات سالن تولید
  PHYSICAL_COUNT       // برگه شمارش انبارگردانی
  MANUAL               // سند دستی با تایید مدیر
}

enum TransactionType {
  INBOUND         // ورود به انبار (+)
  OUTBOUND        // خروج از انبار (-)
  TRANSFER_OUT    // خروج انتقالی به انبار دیگر (-)
  TRANSFER_IN     // ورود انتقالی از انبار دیگر (+)
  ADJUSTMENT_POS  // تعدیل مثبت مازاد انبارگردانی (+)
  ADJUSTMENT_NEG  // تعدیل منفی کسری انبارگردانی (-)
}

enum OrderLineStatus {
  PENDING              // در انتظار برنامه‌ریزی
  IN_PRODUCTION        // در فرآیند تولید
  PARTIALLY_FULFILLED  // تحویل جزیی انجام شده
  COMPLETED            // تحویل کامل شده
  CANCELLED            // لغو شده
}

enum PlanStatus {
  DRAFT       // پیش‌نویس برنامه تولید
  APPROVED    // تایید مدیریت و ابلاغ به سالن
  IN_PROGRESS // در دست تولید
  COMPLETED   // خاتمه یافته
  CANCELLED   // ابطال شده
}

enum PlanLineStatus {
  PLANNED      // برنامه‌ریزی شده
  RELEASED     // تبدیل به دستور ساخت
  IN_PROGRESS  // در حال اجرا در خطوط
  COMPLETED    // تولید کامل
  CANCELLED    // لغو شده
}

enum MOStatus {
  PLANNED      // صادر شده
  RELEASED     // ابلاغ به سالن و تخصیص متریال
  IN_PROGRESS  // در حال تولید روی پرس‌ها
  SUSPENDED    // توقف موقت به علت نقص متریال یا قالب
  COMPLETED    // تولید سهمیه تکمیل شده
  CLOSED       // مختومه و حسابداری صنعتی ثبت شده
  CANCELLED    // لغو شده
}

enum ProductionOpStatus {
  PENDING      // منتظر اتمام عملیات قبلی
  READY        // آماده اجرا
  IN_PROGRESS  // در حال اجرا
  COMPLETED    // به پایان رسیده
  SKIPPED      // رد شده با مجوز مهندسی
}

enum ScrapReason {
  TEAR_CRACK                // پارگی و ترک در کشش
  WRINKLING                 // چروک‌افتادگی در بلنک
  DIMENSIONAL_OUT_OF_SPEC   // خارج از تلرانس نقشه مهندسی
  BURR_HIGH                 // پلیسه بیش از حد مجاز برش
  SURFACE_SCRATCH           // خط و خش و زدگی سطح ورق
  MATERIAL_DEFECT           // عیب متالورژیکی ورق (ناخالصی فولادساز)
  SETUP_SCRAP               // ضایعات تنظیم و ستاپ قالب
  MACHINE_MALFUNCTION       // عیب پرس، عدم هم‌راستایی، افت فشار روغن
  OTHER                     // سایر موارد
}

enum TransferStatus {
  DISPATCHED   // ارسال شده از سالن مبدا
  RECEIVED     // تایید دریافت در سالن مقصد
  REJECTED     // عودت داده شده به علت عدم تطابق
  CANCELLED    // ابطال شده
}

enum AssignmentStatus {
  SCHEDULED    // زمان‌بندی شده
  ACTIVE       // در حال اجرا روی دستگاه
  COMPLETED    // پایان یافته
  CANCELLED    // لغو شده
}

enum ReservationStatus {
  ACTIVE       // رزرو فعال جهت دستور کار
  CONSUMED     // مصرف قطعی در تولید
  RELEASED     // لغو رزرو و برگشت به موجودی آزاد
  EXPIRED      // منقضی شده
}

enum LotStatus {
  AVAILABLE    // آماده مصرف
  IN_USE       // در حال نواربری یا پای پرس
  CONSUMED     // مصرف کامل شده
  QUARANTINE   // قرنطینه آزمایشگاه متالورژی
  REJECTED     // عدم انطباق کیفی و برگشت به ساپکو
}

enum ContractStatus {
  DRAFT        // پیش‌نویس قرارداد
  ACTIVE       // فعال و در جریان تحویل
  FULFILLED    // اتمام ظرفیت وزنی قرارداد
  EXPIRED      // پایان مهلت زمانی
  TERMINATED   // فسخ شده
}

enum ContractTxType {
  RECEIPT      // دریافت محموله رول ساپکو
  RETURN       // مرجوعی محموله معیوب
  ADJUSTMENT   // اصلاحیه وزنی باسکول
}

enum RouteStatus {
  DRAFT        // پیش‌نویس مهندسی محصول
  ACTIVE       // نسخه اجرایی معتبر
  OBSOLETE     // منسوخ شده
}

// =========================================================================
// 1. MASTER DATA ENTITIES (اطلاعات پایه)
// =========================================================================

// واحدهای سنجش و اندازه‌گیری
model UnitOfMeasure {
  id          String   @id @default(uuid())
  code        String   @unique // KG, PCS, M, MM, TON, ROLL
  name        String   // کیلوگرم, عدد, متر, میلیمتر, تن, کلاف
  symbol      String   // kg, pcs, m, mm, t, roll
  isBase      Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  parts                   Part[]
  inventoryDocLines       InventoryDocumentLine[]
  inventoryTransactions  InventoryTransaction[]
  productionTransfers     ProductionTransfer[]

  @@map("units_of_measure")
}

// متریال و گریدهای فولاد خام (ورق‌های ساپکو و فولاد مبارکه)
model Material {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g. MAT-DC04, MAT-ST14, MAT-DX51D
  name                 String   // ورق روغنی DC04 کشش عمیق
  grade                String   // DC04, ST12, ST14, DX51D, ST37
  standard             String?  // EN 10130, DIN 1623
  densityKgM3          Decimal  @default(7850) @db.Decimal(10, 2) // چگالی فولاد (kg/m3)
  tensileStrengthMpa   Decimal? @db.Decimal(8, 2)  // استحکام کششی
  yieldStrengthMpa     Decimal? @db.Decimal(8, 2)  // نقطه تسلیم
  elongationPercent    Decimal? @db.Decimal(5, 2)  // درصد ازدیاد طول
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  parts                Part[]
  materialLots         MaterialLot[]
  materialContracts    MaterialContract[]

  @@map("materials")
}

// کاتالوگ قطعات خودرویی (مواد اولیه، قطعات نیمه‌ساخته WIP، محصول نهایی)
model Part {
  id                   String        @id @default(uuid())
  partNumber           String        @unique // e.g. IKCO-206-BRK01, SAPCO-COIL-DC04
  name                 String        // براکت اتصال رام جلو پژو ۲۰۶
  category             PartCategory
  unitId               String
  unit                 UnitOfMeasure @relation(fields: [unitId], references: [id])
  materialId           String?
  material             Material?     @relation(fields: [materialId], references: [id])
  thicknessMm          Decimal?      @db.Decimal(6, 3) // ضخامت ورق (میلیمتر)
  weightNetKg          Decimal       @default(0) @db.Decimal(12, 4) // وزن خالص قطعه (کیلوگرم)
  weightGrossKg        Decimal       @default(0) @db.Decimal(12, 4) // وزن ناخالص/بلنک مصرفی (کیلوگرم)
  customerPartNumber   String?       // کد عظام یا ساپکو قطعه
  carModel             String?       // پژو ۲۰۶، ۲۰۷، تارا، دنا پلاس، شاهین، کوییک
  minSafetyStock       Decimal       @default(0) @db.Decimal(12, 3) // حداقل موجودی اطمینان
  maxStock             Decimal?      @db.Decimal(12, 3)
  leadTimeDays         Int           @default(1)
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  routes               PartRoute[]
  dies                 Die[]
  customerOrderLines   CustomerOrderLine[]
  productionPlanLines  ProductionPlanLine[]
  manufacturingOrders  ManufacturingOrder[]
  inventoryDocLines    InventoryDocumentLine[]
  transactions         InventoryTransaction[]
  reservations         InventoryReservation[]
  stockBalances        StockBalance[]
  materialLots         MaterialLot[]
  productionTransfers  ProductionTransfer[]

  @@index([category, active])
  @@index([carModel])
  @@map("parts")
}

// عملیات‌های استاندارد تولید
model Operation {
  id                           String             @id @default(uuid())
  code                         String             @unique // OP-BLANK, OP-DRAW, OP-BEND, OP-TRIM, OP-SPOT-WELD
  name                         String             // بلنکینگ اولیه، کشش پوسته، خم‌کاری، دوربری، جوش نقطه‌ای
  processType                  ProcessType
  standardLaborCostPerHour     Decimal?           @db.Decimal(12, 2)
  standardMachineCostPerHour   Decimal?           @db.Decimal(12, 2)
  active                       Boolean            @default(true)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  routeOperations              RouteOperation[]
  machineCapabilities          MachineCapability[]
  productionOperations         ProductionOperation[]

  @@map("operations")
}

// مسیرهای تولید قطعه با پشتیبانی از نسخه (Route Versioning)
model PartRoute {
  id             String           @id @default(uuid())
  partId         String
  part           Part             @relation(fields: [partId], references: [id])
  version        String           @default("V1.0") // نسخه مسیر تولید
  status         RouteStatus      @default(ACTIVE)
  effectiveFrom  DateTime         @default(now())
  effectiveTo    DateTime?
  isDefault      Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  operations           RouteOperation[]
  manufacturingOrders  ManufacturingOrder[]

  @@unique([partId, version])
  @@index([partId, status])
  @@map("part_routes")
}

// ترتیب و مشخصات عملیات‌های داخل مسیر تولید
model RouteOperation {
  id                   String          @id @default(uuid())
  routeId              String
  route                PartRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  operationId          String
  operation            Operation       @relation(fields: [operationId], references: [id])
  stepNumber           Int             // 10, 20, 30, 40...
  stepCode             String          // OP10_BLANK, OP20_DRAW
  stepName             String          // شرح عملیات در مسیر
  machineId            String?
  machine              Machine?        @relation(fields: [machineId], references: [id])
  dieId                String?
  die                  Die?            @relation(fields: [dieId], references: [id])
  setupTimeMin         Int             @default(30) // زمان ستاپ و بستن قالب (دقیقه)
  standardCycleTimeSec Int             @default(45) // زمان سیکل استاندارد هر ضرب (ثانیه)
  scrapNormPercent     Decimal         @default(1.5) @db.Decimal(5, 2) // ضایعات مجاز درصدی استاندارد
  transferBatchQty     Decimal         @default(100) @db.Decimal(12, 3) // اندازه بسته انتقال به مرحله بعد

  productionOperations ProductionOperation[]

  @@unique([routeId, stepNumber])
  @@map("route_operations")
}

// ماشین‌آلات و خطوط پرس
model Machine {
  id                   String          @id @default(uuid())
  code                 String          @unique // e.g. PRS-800-01, PRS-400-02, BRK-CNC-01
  name                 String          // پرس هیدرولیک ۸۰۰ تن کشش
  machineType          MachineType
  tonnageCapacity      Decimal?        @db.Decimal(8, 2) // تناژ اسمی پرس (تن)
  bolsterLengthMm      Decimal?        @db.Decimal(8, 2) // طول میز کار پرس (میلیمتر)
  bolsterWidthMm       Decimal?        @db.Decimal(8, 2) // عرض میز کار پرس (میلیمتر)
  strokeLengthMm       Decimal?        @db.Decimal(8, 2) // کورس ضربه پرس (میلیمتر)
  maxStrokesPerMinute  Int?            // حداکثر ضرب در دقیقه (SPM)
  shutHeightMm         Decimal?        @db.Decimal(8, 2) // ارتفاع بسته (Shut Height)
  hallLocation         String          @default("سالن پرس سنگین") // سالن استقرار
  status               MachineStatus   @default(ACTIVE)
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  capabilities         MachineCapability[]
  dieCompatibilities   MachineDieCompatibility[]
  routeOperations      RouteOperation[]
  machineAssignments   MachineAssignment[]
  productionReports    ProductionReport[]
  plannedOperations    ProductionOperation[]

  @@index([machineType, status])
  @@map("machines")
}

// ماتریس قابلیت‌های هر دستگاه (انجام فرایندها و محدودیت‌های ضخامت و تناژ)
model MachineCapability {
  id                   String     @id @default(uuid())
  machineId            String
  machine              Machine    @relation(fields: [machineId], references: [id], onDelete: Cascade)
  operationId          String
  operation            Operation  @relation(fields: [operationId], references: [id])
  maxTonnage           Decimal?   @db.Decimal(8, 2)
  minThicknessMm       Decimal?   @db.Decimal(5, 2)
  maxThicknessMm       Decimal?   @db.Decimal(5, 2)
  efficiencyFactor     Decimal    @default(1.0) @db.Decimal(4, 2) // ضریب راندمان
  isPreferred          Boolean    @default(false)
  notes                String?

  @@unique([machineId, operationId])
  @@map("machine_capabilities")
}

// قالب‌ها و ابزارهای فرم‌دهی و پرس (Dies & Tooling)
model Die {
  id                          String          @id @default(uuid())
  code                        String          @unique // e.g. DIE-206-BRK-OP10, DIE-206-BRK-OP20
  name                        String          // قالب سنبه ماتریس کشش پوسته براکت
  partId                      String
  part                        Part            @relation(fields: [partId], references: [id])
  dieType                     DieType
  tonnageRequired             Decimal         @db.Decimal(8, 2) // تناژ پرس مورد نیاز
  shutHeightMm                Decimal?        @db.Decimal(8, 2) // ارتفاع بسته قالب
  upperWeightKg               Decimal?        @db.Decimal(10, 2) // وزن لنگه بالا
  lowerWeightKg               Decimal?        @db.Decimal(10, 2) // وزن لنگه پایین
  totalWeightKg               Decimal?        @db.Decimal(10, 2)
  totalStrokeTarget           Int             @default(200000) // عمر استاندارد قالب برحسب ضرب
  currentStrokes              Int             @default(0)      // کارکرد ضرب تجمیعی
  lastMaintenanceStrokes      Int             @default(0)      // ضرب در آخرین تعمیرات PM
  strokesBetweenSharpening    Int             @default(25000)  // دوره تیزکاری سنبه ماتریس
  status                      DieStatus       @default(READY)
  storageLocation             String?         // ردیف و پالت در انبار قالب
  active                      Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  machineCompatibilities      MachineDieCompatibility[]
  routeOperations             RouteOperation[]
  productionReports           ProductionReport[]
  plannedOperations           ProductionOperation[]

  @@index([partId, status])
  @@map("dies")
}

// ماتریس سازگاری قالب با پرس‌ها (Machine-Die Compatibility)
model MachineDieCompatibility {
  id                   String   @id @default(uuid())
  machineId            String
  machine              Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  dieId                String
  die                  Die      @relation(fields: [dieId], references: [id], onDelete: Cascade)
  isOptimal            Boolean  @default(true)
  adapterPlateRequired Boolean  @default(false) // نیاز به صفحه واسط روبند
  adapterPlateCode     String?
  clampingType         String?  // هیدرولیک، پیچ روبند T، مگنت
  setupDifficulty      String?  // LOW, MEDIUM, HIGH
  notes                String?

  @@unique([machineId, dieId])
  @@map("machine_die_compatibilities")
}

// انبارها
model Warehouse {
  id             String        @id @default(uuid())
  code           String        @unique // WH-RAW, WH-WIP-STAMP, WH-WIP-WELD, WH-FINISHED, WH-SCRAP
  name           String        // انبار کویل و ورق ساپکو, انبار کار در جریان پرس...
  type           WarehouseType
  address        String?
  managerName    String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  locations                WarehouseLocation[]
  sourceInventoryDocs      InventoryDocument[]    @relation("SourceWarehouse")
  targetInventoryDocs      InventoryDocument[]    @relation("TargetWarehouse")
  inventoryTransactions   InventoryTransaction[]
  stockBalances            StockBalance[]
  inventoryReservations    InventoryReservation[]
  fromTransfers            ProductionTransfer[]   @relation("FromWarehouse")
  toTransfers              ProductionTransfer[]   @relation("ToWarehouse")

  @@map("warehouses")
}

// موقعیت‌های فیزیکی داخل انبار (راهرو، قفسه، طبقه، پالت)
model WarehouseLocation {
  id             String    @id @default(uuid())
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code           String    // LOC-A-01-01
  aisle          String?   // راهرو
  rack           String?   // قفسه
  shelf          String?   // طبقه
  bin            String?   // بافت یا پالت
  maxCapacityKg  Decimal?  @db.Decimal(12, 3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  inventoryDocLines        InventoryDocumentLine[] @relation("Location")
  targetInventoryDocLines  InventoryDocumentLine[] @relation("TargetLocation")
  inventoryTransactions   InventoryTransaction[]
  stockBalances            StockBalance[]
  materialLots             MaterialLot[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

// شیفت‌های کاری کارخانه
model Shift {
  id               String   @id @default(uuid())
  code             String   @unique // SHIFT-MORN, SHIFT-EVE, SHIFT-NIGHT
  name             String   // شیفت صبح، شیفت عصر، شیفت شب
  startTime        String   // "07:00"
  endTime          String   // "15:30"
  breakDurationMin Int      @default(60)
  productiveHours  Decimal  @default(7.5) @db.Decimal(4, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  productionReports   ProductionReport[]
  machineAssignments  MachineAssignment[]

  @@map("shifts")
}

// مشتریان و تامین‌کنندگان (ساپکو، ایران خودرو، سایپا)
model Customer {
  id               String   @id @default(uuid())
  code             String   @unique // CUST-SAPCO, CUST-IKCO, CUST-SAIPA
  name             String   // ساپکو (طراحی مهندسی و تامین قطعات ایران خودرو)
  commercialCode   String?
  nationalId       String?
  economicCode     String?
  phone            String?
  contactPerson    String?
  address          String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerOrders     CustomerOrder[]
  materialContracts  MaterialContract[]

  @@map("customers")
}

// =========================================================================
// 2. PRODUCTION DATA ENTITIES (داده‌های برنامه‌ریزی و تولید)
// =========================================================================

// سفارش‌های مشتری / برنامه‌های تحویل ساپکو
model CustomerOrder {
  id                      String         @id @default(uuid())
  orderNumber             String         @unique // e.g. CO-1403-0901
  customerId              String
  customer                Customer       @relation(fields: [customerId], references: [id])
  orderDate               DateTime
  requestedDeliveryDate   DateTime
  customerContractNumber  String?        // شماره قرارداد یا برنامه ساپکو
  documentStatus          DocumentStatus @default(DRAFT)
  notes                   String?
  totalAmount             Decimal?       @db.Decimal(16, 2)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  orderLines              CustomerOrderLine[]
  planLines               ProductionPlanLine[]
  reservations            InventoryReservation[]

  @@index([customerId, documentStatus])
  @@map("customer_orders")
}

// ردیف‌های سفارش مشتری
model CustomerOrderLine {
  id               String           @id @default(uuid())
  orderId          String
  order            CustomerOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId           String
  part             Part             @relation(fields: [partId], references: [id])
  lineNumber       Int
  orderedQty       Decimal          @db.Decimal(12, 3)
  deliveredQty     Decimal          @default(0) @db.Decimal(12, 3)
  unitPrice        Decimal?         @db.Decimal(14, 2)
  requestedDate    DateTime
  status           OrderLineStatus  @default(PENDING)

  @@unique([orderId, lineNumber])
  @@index([partId, status])
  @@map("customer_order_lines")
}

// برنامه کلان و هفتگی تولید (Production Plan)
model ProductionPlan {
  id                 String       @id @default(uuid())
  planNumber         String       @unique // e.g. PLN-1403-W42
  title              String       // برنامه تولید هفتگی قطعات پرسی تارا و ۲۰۶
  startDate          DateTime
  endDate            DateTime
  status             PlanStatus   @default(DRAFT)
  approvedByUserId   String?
  approvedAt         DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  planLines            ProductionPlanLine[]
  manufacturingOrders  ManufacturingOrder[]

  @@index([status, startDate])
  @@map("production_plans")
}

// ردیف‌های برنامه تولید
model ProductionPlanLine {
  id                 String             @id @default(uuid())
  planId             String
  plan               ProductionPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  partId             String
  part               Part               @relation(fields: [partId], references: [id])
  customerOrderId    String?
  customerOrder      CustomerOrder?     @relation(fields: [customerOrderId], references: [id])
  plannedQty         Decimal            @db.Decimal(12, 3)
  producedQty        Decimal            @default(0) @db.Decimal(12, 3)
  plannedStartDate   DateTime
  plannedEndDate     DateTime
  priority           Int                @default(1) // 1: عادی, 2: فوری, 3: بحرانی خط ساپکو
  status             PlanLineStatus     @default(PLANNED)

  manufacturingOrders ManufacturingOrder[]

  @@index([partId, status])
  @@map("production_plan_lines")
}

// دستور ساخت کارگاهی / کارت سفارش تولید (Manufacturing Order / Work Order)
model ManufacturingOrder {
  id                   String          @id @default(uuid())
  moNumber             String          @unique // e.g. MO-1403-1082
  partId               String
  part                 Part            @relation(fields: [partId], references: [id])
  routeId              String
  route                PartRoute       @relation(fields: [routeId], references: [id])
  planId               String?
  plan                 ProductionPlan? @relation(fields: [planId], references: [id])
  planLineId           String?
  planLine             ProductionPlanLine? @relation(fields: [planLineId], references: [id])
  targetQty            Decimal         @db.Decimal(12, 3) // تعداد کل سفارش
  completedQty         Decimal         @default(0) @db.Decimal(12, 3) // تعداد سالم نهایی
  scrapQty             Decimal         @default(0) @db.Decimal(12, 3) // تعداد کل ضایعات
  scheduledStartDate   DateTime
  scheduledEndDate     DateTime
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  priority             Int             @default(1)
  status               MOStatus        @default(PLANNED)
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  operations           ProductionOperation[]
  reports              ProductionReport[]
  transfers            ProductionTransfer[]
  reservations         InventoryReservation[]
  transactions         InventoryTransaction[]

  @@index([partId, status])
  @@index([scheduledStartDate, scheduledEndDate])
  @@map("manufacturing_orders")
}

// عملیات‌های اجرایی دستور ساخت روی خط تولید
model ProductionOperation {
  id                   String              @id @default(uuid())
  manufacturingOrderId String
  manufacturingOrder   ManufacturingOrder  @relation(fields: [manufacturingOrderId], references: [id], onDelete: Cascade)
  operationId          String
  operation            Operation           @relation(fields: [operationId], references: [id])
  routeOperationId     String?
  routeOperation       RouteOperation?     @relation(fields: [routeOperationId], references: [id])
  stepNumber           Int                 // 10, 20, 30...
  plannedMachineId     String?
  plannedMachine       Machine?            @relation(fields: [plannedMachineId], references: [id])
  plannedDieId         String?
  plannedDie           Die?                @relation(fields: [plannedDieId], references: [id])
  plannedQty           Decimal             @db.Decimal(12, 3)
  inputQty             Decimal             @default(0) @db.Decimal(12, 3)
  outputGoodQty        Decimal             @default(0) @db.Decimal(12, 3)
  outputScrapQty       Decimal             @default(0) @db.Decimal(12, 3)
  status               ProductionOpStatus  @default(PENDING)
  startDate            DateTime?
  endDate              DateTime?

  reports              ProductionReport[]
  assignments          MachineAssignment[]
  scraps               ProductionScrap[]

  @@unique([manufacturingOrderId, stepNumber])
  @@index([status])
  @@map("production_operations")
}

// گزارش ثبت عملکرد شیفت و تولید روزانه
model ProductionReport {
  id                      String               @id @default(uuid())
  reportNumber            String               @unique // e.g. PR-1403-1102-01
  manufacturingOrderId    String
  manufacturingOrder      ManufacturingOrder   @relation(fields: [manufacturingOrderId], references: [id])
  productionOperationId   String
  productionOperation     ProductionOperation  @relation(fields: [productionOperationId], references: [id])
  machineId               String
  machine                 Machine              @relation(fields: [machineId], references: [id])
  dieId                   String?
  die                     Die?                 @relation(fields: [dieId], references: [id])
  shiftId                 String
  shift                   Shift                @relation(fields: [shiftId], references: [id])
  operatorUserId          String?
  operatorUser            User?                @relation("ReportOperator", fields: [operatorUserId], references: [id])
  supervisorUserId        String?
  supervisorUser          User?                @relation("ReportSupervisor", fields: [supervisorUserId], references: [id])
  reportDate              DateTime             // تاریخ شیفت کاری (UTC)
  strokeCounterStart      Int?                 // شمارنده ضرب اول شیفت
  strokeCounterEnd        Int?                 // شمارنده ضرب پایان شیفت
  goodQuantity            Decimal              @db.Decimal(12, 3) // تعداد سالم
  scrapQuantity           Decimal              @default(0) @db.Decimal(12, 3) // تعداد ضایعات
  reworkQuantity          Decimal              @default(0) @db.Decimal(12, 3) // تعداد دوباره‌کاری
  runTimeMinutes          Int                  @default(0) // دقایق کار مفید
  downtimeMinutes         Int                  @default(0) // دقایق توقف پرس
  downtimeReason          String?              // علت توقف (خرابی قالب، تعویض رول، نقص برق)
  notes                   String?
  documentStatus          DocumentStatus       @default(CONFIRMED)
  postingStatus           PostingStatus        @default(POSTED)
  createdAt               DateTime             @default(now())

  scraps                  ProductionScrap[]
  inventoryTransactions  InventoryTransaction[]

  @@index([manufacturingOrderId, reportDate])
  @@index([machineId, reportDate])
  @@map("production_reports")
}

// ریز ضایعات تولیدی به تفکیک علت مهندسی
model ProductionScrap {
  id                      String              @id @default(uuid())
  productionReportId      String
  productionReport        ProductionReport    @relation(fields: [productionReportId], references: [id], onDelete: Cascade)
  productionOperationId   String
  productionOperation     ProductionOperation @relation(fields: [productionOperationId], references: [id])
  scrapReason             ScrapReason
  quantity                Decimal             @db.Decimal(12, 3) // تعداد قطعه ضایعاتی
  weightKg                Decimal             @db.Decimal(12, 3) // وزن ضایعات آهن (کیلوگرم)
  isRecoverable           Boolean             @default(false)    // آیا قابل بازیافت یا بلنک قطعه کوچکتراست؟
  notes                   String?
  createdAt               DateTime            @default(now())

  @@index([productionReportId])
  @@index([scrapReason])
  @@map("production_scraps")
}

// حواله‌های انتقال نیمه‌ساخته (WIP Transfers) بین مراحل تولید
model ProductionTransfer {
  id                      String             @id @default(uuid())
  transferNumber          String             @unique // TRF-1403-0801
  manufacturingOrderId    String
  manufacturingOrder      ManufacturingOrder @relation(fields: [manufacturingOrderId], references: [id])
  partId                  String
  part                    Part               @relation(fields: [partId], references: [id])
  fromStageOperationId    String?
  toStageOperationId      String?
  fromWarehouseId         String
  fromWarehouse           Warehouse          @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId           String
  toWarehouse             Warehouse          @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  quantity                Decimal            @db.Decimal(12, 3)
  unitId                  String
  unit                    UnitOfMeasure      @relation(fields: [unitId], references: [id])
  dispatchedByUserId      String?
  dispatchedAt            DateTime           @default(now())
  receivedByUserId        String?
  receivedAt              DateTime?
  status                  TransferStatus     @default(DISPATCHED)
  inventoryDocId          String?
  notes                   String?

  @@index([partId, status])
  @@map("production_transfers")
}

// تخصیص و نوبت‌دهی دستگاه و اپراتور (Machine Assignments)
model MachineAssignment {
  id                      String              @id @default(uuid())
  machineId               String
  machine                 Machine             @relation(fields: [machineId], references: [id])
  productionOperationId   String
  productionOperation     ProductionOperation @relation(fields: [productionOperationId], references: [id])
  shiftId                 String
  shift                   Shift               @relation(fields: [shiftId], references: [id])
  assignedDate            DateTime
  assignedOperatorId      String?
  assignedOperator        User?               @relation("OperatorAssignments", fields: [assignedOperatorId], references: [id])
  status                  AssignmentStatus    @default(SCHEDULED)
  notes                   String?
  createdAt               DateTime            @default(now())

  @@index([machineId, assignedDate, shiftId])
  @@map("machine_assignments")
}

// =========================================================================
// 3. INVENTORY DATA ENTITIES (داده‌های انبارداری و زنجیره تامین ساپکو)
// =========================================================================

// اسناد انبار (سربرگ رسید، حواله، جابجایی و انبارگردانی)
model InventoryDocument {
  id                 String            @id @default(uuid())
  documentNumber     String            @unique // e.g. DOC-REC-1403-001
  documentType       InventoryDocType
  documentDate       DateTime
  documentStatus     DocumentStatus    @default(DRAFT)
  postingStatus      PostingStatus     @default(UNPOSTED)
  warehouseId        String
  warehouse          Warehouse         @relation("SourceWarehouse", fields: [warehouseId], references: [id])
  targetWarehouseId  String?
  targetWarehouse    Warehouse?        @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  referenceType      DocReferenceType?
  referenceNumber    String?           // شماره بارنامه ساپکو یا دستور تولید
  createdByUserId    String
  createdByUser      User              @relation("DocCreator", fields: [createdByUserId], references: [id])
  postedByUserId     String?
  postedAt           DateTime?
  isReversed         Boolean           @default(false)
  reversalOfId       String?           @unique // ارجاع به سند ابطال‌شده
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  lines              InventoryDocumentLine[]
  transactions       InventoryTransaction[]

  @@index([documentType, documentDate])
  @@index([warehouseId, postingStatus])
  @@map("inventory_documents")
}

// ردیف‌های اقلام سند انبار
model InventoryDocumentLine {
  id                 String             @id @default(uuid())
  documentId         String
  document           InventoryDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lineNumber         Int
  partId             String
  part               Part               @relation(fields: [partId], references: [id])
  materialLotId      String?
  materialLot        MaterialLot?       @relation(fields: [materialLotId], references: [id])
  locationId         String?
  location           WarehouseLocation? @relation("Location", fields: [locationId], references: [id])
  targetLocationId   String?
  targetLocation     WarehouseLocation? @relation("TargetLocation", fields: [targetLocationId], references: [id])
  quantity           Decimal            @db.Decimal(12, 3)
  unitId             String
  unit               UnitOfMeasure      @relation(fields: [unitId], references: [id])
  weightKg           Decimal            @db.Decimal(12, 3) // وزن متناظر به کیلوگرم
  unitCost           Decimal?           @db.Decimal(14, 2)
  notes              String?

  @@unique([documentId, lineNumber])
  @@index([partId, materialLotId])
  @@map("inventory_document_lines")
}

// کاردکس غیرقابل دستکاری و تراکنش‌های رسمی انبار (Immutable Transaction Ledger)
model InventoryTransaction {
  id                      String             @id @default(uuid())
  transactionNumber       String             @unique // e.g. TRX-1403-0001
  documentId              String?
  document                InventoryDocument? @relation(fields: [documentId], references: [id])
  documentLineId          String?
  partId                  String
  part                    Part               @relation(fields: [partId], references: [id])
  materialLotId           String?
  materialLot             MaterialLot?       @relation(fields: [materialLotId], references: [id])
  warehouseId             String
  warehouse               Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId              String?
  location                WarehouseLocation? @relation(fields: [locationId], references: [id])
  transactionType         TransactionType
  quantity                Decimal            @db.Decimal(12, 3) // مقدار مطلق
  quantitySigned          Decimal            @db.Decimal(12, 3) // مقدار با علامت (مثبت ورودی، منفی خروجی)
  unitId                  String
  unit                    UnitOfMeasure      @relation(fields: [unitId], references: [id])
  weightKg                Decimal            @db.Decimal(12, 3) // وزن مطلق به کیلوگرم
  weightKgSigned          Decimal            @db.Decimal(12, 3) // وزن با علامت (کیلوگرم)
  balanceAfter            Decimal?           @db.Decimal(12, 3) // مانده مقداری پس از تراکنش
  balanceKgAfter          Decimal?           @db.Decimal(12, 3) // مانده وزنی پس از تراکنش
  transactionDate         DateTime           // زمان وقوع به UTC
  postingStatus           PostingStatus      @default(POSTED)
  isReversal              Boolean            @default(false)
  reversalOfTrxId         String?            // ارجاع به تراکنش معکوس‌شده
  createdByUserId         String
  createdByUser           User               @relation("TxCreator", fields: [createdByUserId], references: [id])
  productionReportId      String?
  productionReport        ProductionReport?  @relation(fields: [productionReportId], references: [id])
  manufacturingOrderId    String?
  manufacturingOrder      ManufacturingOrder? @relation(fields: [manufacturingOrderId], references: [id])
  createdAt               DateTime           @default(now())

  @@index([partId, warehouseId, transactionDate])
  @@index([warehouseId, transactionDate])
  @@index([materialLotId])
  @@map("inventory_transactions")
}

// رزرو مواد و قطعات برای دستورات ساخت یا سفارشات فروش
model InventoryReservation {
  id                 String             @id @default(uuid())
  reservationNumber  String             @unique // RES-1403-001
  partId             String
  part               Part               @relation(fields: [partId], references: [id])
  warehouseId        String
  warehouse          Warehouse          @relation(fields: [warehouseId], references: [id])
  materialLotId      String?
  materialLot        MaterialLot?       @relation(fields: [materialLotId], references: [id])
  reservedForMOId    String?
  reservedForMO      ManufacturingOrder? @relation(fields: [reservedForMOId], references: [id])
  reservedForCOId    String?
  reservedForCO      CustomerOrder?     @relation(fields: [reservedForCOId], references: [id])
  quantity           Decimal            @db.Decimal(12, 3)
  weightKg           Decimal            @db.Decimal(12, 3)
  status             ReservationStatus  @default(ACTIVE)
  validUntil         DateTime?
  createdByUserId    String
  createdByUser      User               @relation("ReservationCreator", fields: [createdByUserId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([partId, warehouseId, status])
  @@map("inventory_reservations")
}

// مانده موجودی تجمیعی فیزیکی و قابل دسترس (Stock Balances Snapshot)
model StockBalance {
  id                   String             @id @default(uuid())
  partId               String
  part                 Part               @relation(fields: [partId], references: [id])
  warehouseId          String
  warehouse            Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId           String?
  location             WarehouseLocation? @relation(fields: [locationId], references: [id])
  materialLotId        String?
  materialLot          MaterialLot?       @relation(fields: [materialLotId], references: [id])
  quantityOnHand       Decimal            @default(0) @db.Decimal(12, 3) // موجودی فیزیکی
  quantityReserved     Decimal            @default(0) @db.Decimal(12, 3) // مقدار رزرو شده
  quantityAvailable    Decimal            @default(0) @db.Decimal(12, 3) // مقدار آزاد = موجودی منهای رزرو
  weightKgOnHand       Decimal            @default(0) @db.Decimal(12, 3) // وزن فیزیکی (کیلوگرم)
  weightKgReserved     Decimal            @default(0) @db.Decimal(12, 3) // وزن رزرو شده (کیلوگرم)
  weightKgAvailable    Decimal            @default(0) @db.Decimal(12, 3) // وزن آزاد (کیلوگرم)
  lastTransactionAt    DateTime?
  updatedAt            DateTime           @updatedAt

  @@unique([partId, warehouseId, locationId, materialLotId])
  @@index([partId, warehouseId])
  @@map("stock_balances")
}

// رول‌ها، کلاف‌های ورق ساپکو و بچ‌های متریال (Material Lots & Coils)
model MaterialLot {
  id                     String             @id @default(uuid())
  lotNumber              String             @unique // e.g. COIL-SAP-1403-0498
  materialId             String
  material               Material           @relation(fields: [materialId], references: [id])
  partId                 String?
  part                   Part?              @relation(fields: [partId], references: [id])
  supplierContractId     String?
  supplierContract       MaterialContract?  @relation(fields: [supplierContractId], references: [id])
  heatNumber             String?            // شماره ذوب فولاد مبارکه
  coilSerialNumber       String?            // شماره سریال کلاف سازنده
  thicknessMm            Decimal            @db.Decimal(6, 3) // ضخامت واقعی اندازه‌گیری شده
  widthMm                Decimal            @db.Decimal(8, 2) // عرض رول
  lengthMm               Decimal?           @db.Decimal(10, 2)
  initialWeightKg        Decimal            @db.Decimal(12, 3) // وزن اولیه ورودی باسکول
  remainingWeightKg      Decimal            @db.Decimal(12, 3) // مانده وزن فعلی رول
  warehouseLocationId    String?
  warehouseLocation      WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  status                 LotStatus          @default(AVAILABLE)
  receivedDate           DateTime
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  inventoryDocLines      InventoryDocumentLine[]
  transactions           InventoryTransaction[]
  reservations           InventoryReservation[]
  stockBalances          StockBalance[]
  contractTransactions   MaterialContractTransaction[]

  @@index([materialId, status])
  @@index([heatNumber])
  @@map("material_lots")
}

// سهمیه‌ها و قراردادهای تامین ورق ساپکو (SAPCO Material Contracts)
model MaterialContract {
  id                      String             @id @default(uuid())
  contractNumber          String             @unique // e.g. CNT-SAPCO-1403-M10
  supplierCustomerId      String
  supplierCustomer        Customer           @relation(fields: [supplierCustomerId], references: [id])
  title                   String             // سهمیه سه ماهه سوم ورق DC04 خودرو تارا
  materialId              String
  material                Material           @relation(fields: [materialId], references: [id])
  totalAllocatedWeightKg  Decimal            @db.Decimal(14, 3) // کل تناژ تخصیصی سهمیه ساپکو
  receivedWeightKg        Decimal            @default(0) @db.Decimal(14, 3) // تناژ دریافت شده تا کنون
  startDate               DateTime
  endDate                 DateTime
  status                  ContractStatus     @default(ACTIVE)
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  materialLots            MaterialLot[]
  transactions            MaterialContractTransaction[]

  @@index([supplierCustomerId, status])
  @@map("material_contracts")
}

// تراکنش‌ها و حواله‌های تحویل سهمیه قرارداد ساپکو
model MaterialContractTransaction {
  id               String            @id @default(uuid())
  contractId       String
  contract         MaterialContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  lotId            String?
  lot              MaterialLot?      @relation(fields: [lotId], references: [id])
  transactionType  ContractTxType
  weightKg         Decimal           @db.Decimal(12, 3)
  waybillNumber    String?           // شماره بارنامه رسمی حمل ساپکو
  receiptDate      DateTime
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([contractId, receiptDate])
  @@map("material_contract_transactions")
}

// =========================================================================
// 4. CONTROL DATA ENTITIES (کاربران، نقش‌ها، سطوح دسترسی و ممیزی)
// =========================================================================

// کاربران سیستم
model User {
  id             String    @id @default(uuid())
  username       String    @unique
  email          String    @unique
  fullName       String    // نام و نام خانوادگی
  personnelCode  String?   @unique // کد پرسنلی کارخانه
  passwordHash   String?
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  active         Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdDocuments       InventoryDocument[]    @relation("DocCreator")
  createdTransactions   InventoryTransaction[] @relation("TxCreator")
  createdReservations    InventoryReservation[] @relation("ReservationCreator")
  operatorReports        ProductionReport[]     @relation("ReportOperator")
  supervisorReports      ProductionReport[]     @relation("ReportSupervisor")
  machineAssignments     MachineAssignment[]    @relation("OperatorAssignments")
  auditLogs              AuditLog[]

  @@map("users")
}

// نقش‌های کاربری (مدیر، برنامه‌ریزی، انبار، QC، سرپرست سالن، اپراتور)
model Role {
  id             String    @id @default(uuid())
  name           String    @unique // ADMIN, PRODUCTION_MANAGER, WAREHOUSE_KEEPER, QC_INSPECTOR, LINE_SUPERVISOR, OPERATOR
  displayName    String    // مدیر ارشد، مدیر برنامه‌ریزی و تولید، سرپرست انبار، بازرس کنترل کیفیت، سرپرست خط و شیفت پرس، اپراتور
  description    String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  users          User[]
  permissions    RolePermission[]

  @@map("roles")
}

// مجوزها و دسترسی‌های ریز سیستم
model Permission {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. PARTS_READ, PARTS_WRITE, INVENTORY_POST, INVENTORY_REVERSE, MO_RELEASE, REPORT_SUBMIT, AUDIT_VIEW
  module         String    // MASTER_DATA, PRODUCTION, INVENTORY, CONTROL
  name           String    // شرح دسترسی
  description    String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

// جدول رابط انتساب مجوز به نقش‌ها
model RolePermission {
  id             String     @id @default(uuid())
  roleId         String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId   String
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// لاگ ممیزی و رویدادنگاری تغییرات حساس
model AuditLog {
  id             String    @id @default(uuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  action         String    // VOUCHER_POST, VOUCHER_REVERSE, MASTER_DATA_CREATE, MO_RELEASE, DIE_STATUS_CHANGE
  entityName     String    // InventoryDocument, ManufacturingOrder, Part, Machine
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime  @default(now()) // ذخیره‌سازی همواره بر حسب UTC

  @@index([entityName, entityId])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

// شمارنده‌های شماره اسناد یکتا و اتمیک (Document Sequences)
model DocumentSequence {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. "INV_DOC_REC_1403", "MO_1403", "TRX_1403", "PR_1403"
  prefix         String    // "REC-1403-", "MO-1403-", "TRX-1403-"
  currentValue   Int       @default(0)
  step           Int       @default(1)
  padding        Int       @default(4)
  year           String?   // "1403"
  updatedAt      DateTime  @updatedAt

  @@map("document_sequences")
}

// تنظیمات و پارامترهای سیستمی
model SystemSetting {
  id             String    @id @default(uuid())
  key            String    @unique // e.g. "DEFAULT_SCRAP_NORM_PERCENT", "SAPCO_SYNC_INTERVAL_MIN"
  value          String
  category       String    @default("GENERAL") // GENERAL, INVENTORY, PRODUCTION, INTEGRATION
  description    String?
  isEncrypted    Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  @@map("system_settings")
}
